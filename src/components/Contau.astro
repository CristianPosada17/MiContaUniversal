---
// Micont@U — el libro del logo convertido en personaje.
// Redibujado en vector porque el logo entregado es un JPEG dentro de un .svg.
// `uid` hace unicos los ids de los degradados cuando hay varios en la pagina.
const { class: className = "", uid = "c" } = Astro.props;
const navy = `mcu-n-${uid}`;
const green = `mcu-g-${uid}`;
const mid = `mcu-m-${uid}`;
---
<svg class={`contau ${className}`} viewBox="0 0 240 205" role="img" aria-label="Micont@U">
  <defs>
    <linearGradient id={navy} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#062748" /><stop offset="1" stop-color="#17457C" />
    </linearGradient>
    <linearGradient id={green} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#045C2C" /><stop offset="1" stop-color="#1FA24C" />
    </linearGradient>
    <linearGradient id={mid} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#0A3660" /><stop offset="1" stop-color="#0F7D3D" />
    </linearGradient>
  </defs>

  <rect x="24" y="102" width="26" height="52" rx="5" fill={`url(#${navy})`} />
  <rect x="56" y="74" width="28" height="80" rx="5" fill={`url(#${navy})`} />
  <rect x="156" y="74" width="28" height="80" rx="5" fill={`url(#${green})`} />
  <rect x="190" y="102" width="26" height="52" rx="5" fill={`url(#${green})`} />

  <rect x="90" y="40" width="60" height="116" rx="11" fill={`url(#${mid})`} />
  <g class="contau-eyes">
    <ellipse cx="106" cy="82" rx="10" ry="11.5" fill="#fff" />
    <ellipse cx="134" cy="82" rx="10" ry="11.5" fill="#fff" />
    <circle cx="107.6" cy="84" r="4.8" fill="#062748" />
    <circle cx="135.6" cy="84" r="4.8" fill="#062748" />
    <circle cx="109.6" cy="81.2" r="1.8" fill="#fff" />
    <circle cx="137.6" cy="81.2" r="1.8" fill="#fff" />
  </g>
  <path d="M108 105 Q120 116 132 105" stroke="#fff" stroke-width="3.6" fill="none" stroke-linecap="round" />

  <path d="M6 126 C42 118, 86 130, 120 156 L120 190 C86 162, 42 150, 6 158 Z" fill={`url(#${navy})`} />
  <path d="M234 126 C198 118, 154 130, 120 156 L120 190 C154 162, 198 150, 234 158 Z" fill={`url(#${green})`} />
  <path d="M18 134 C50 128, 88 139, 118 161" stroke="#fff" stroke-opacity=".5" stroke-width="2.8" fill="none" stroke-linecap="round" />
  <path d="M222 134 C190 128, 152 139, 122 161" stroke="#fff" stroke-opacity=".5" stroke-width="2.8" fill="none" stroke-linecap="round" />
</svg>
