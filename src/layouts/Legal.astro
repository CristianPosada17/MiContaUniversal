---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { container, eyebrow } from "../lib/ui";

// Marco comun de las paginas legales. El texto va completo en cada idioma
// dentro de bloques data-only="es" / data-only="en".
const { title, titleEn, description, descriptionEn, path, heading, headingEn, updated, updatedEn } = Astro.props;
---
<Layout title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn} path={path}>
  <Header />
  <main class="bg-[var(--bg-2)] py-16 lg:py-24">
    <div class={container}>
      <article class="legal mx-auto max-w-[820px] rounded-[var(--radius)] border border-[color:var(--border)] bg-white p-7 shadow-[var(--shadow-sm)] sm:p-12">
        <span class={eyebrow} data-en="Legal">Legal</span>
        <h1 class="text-[clamp(1.9rem,4vw,2.7rem)] font-extrabold leading-[1.15] text-[var(--navy-900)]" data-en={headingEn}>{heading}</h1>
        <p class="mt-3 text-[0.9rem] text-[var(--muted)]" data-en={updatedEn}>{updated}</p>
        <slot />
      </article>
    </div>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
