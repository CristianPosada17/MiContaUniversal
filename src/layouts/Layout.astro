---
import "../styles/global.css";

const {
  title = "Contabilidad y Asesoria para Negocios en Cincinnati, Ohio | Mi Conta Universal",
  description = "Contabilidad, nomina, reportes financieros y asesoria para pequenos negocios en Cincinnati y en todo Ohio. Te atendemos en espanol e ingles. Llama o escribe por WhatsApp al (513) 827-0407.",
  image = "/og-image.jpg",
} = Astro.props;

// Se llenan cuando el cliente entregue las cuentas. Vacios = no cargan.
const GA_MEASUREMENT_ID = "";
const META_PIXEL_ID = "";
const GSC_VERIFICATION = "";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://micontau.com/#business",
      name: "Mi Conta Universal",
      description:
        "Contabilidad, nomina, reportes financieros, registro de negocios, licencias y asesoria para pequenos negocios en Cincinnati y en todo el estado de Ohio.",
      url: "https://micontau.com",
      telephone: "+1-513-827-0407",
      image: "https://micontau.com/logo.png",
      logo: "https://micontau.com/logo.png",
      address: {
        "@type": "PostalAddress",
        streetAddress: "1238 W Kemper Rd",
        addressLocality: "Cincinnati",
        addressRegion: "OH",
        postalCode: "45240",
        addressCountry: "US",
      },
      areaServed: { "@type": "State", name: "Ohio" },
      availableLanguage: ["es", "en"],
      sameAs: ["https://www.facebook.com/share/1BkY8GzJZJ/"],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "20:00",
        },
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://micontau.com/#website",
      url: "https://micontau.com",
      name: "Mi Conta Universal",
      inLanguage: "es-US",
      publisher: { "@id": "https://micontau.com/#business" },
    },
  ],
};

const analyticsBootstrap = [
  GA_MEASUREMENT_ID &&
    `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`,
  META_PIXEL_ID &&
    `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`,
]
  .filter(Boolean)
  .join("\n");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="contabilidad Cincinnati, contador en espanol Cincinnati, nomina para negocios Ohio, registro de negocios Ohio, bookkeeping Cincinnati OH, small business accountant Ohio, business consulting Cincinnati"
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#062748" />
    <link rel="canonical" href="https://micontau.com/" />
    <link rel="alternate" hreflang="es-us" href="https://micontau.com/" />
    <link rel="alternate" hreflang="en-us" href="https://micontau.com/?lang=en" />
    <link rel="alternate" hreflang="x-default" href="https://micontau.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mi Conta Universal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://micontau.com/" />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_US" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <noscript><style>.reveal,.reveal-left,.reveal-right,.reveal-scale{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <slot />

    <script is:inline>
      /* ---------- Idioma ES / EN ---------- */
      (function () {
        var META = {
          es: {
            title: "Contabilidad y Asesoria para Negocios en Cincinnati, Ohio | Mi Conta Universal",
            desc: "Contabilidad, nomina, reportes financieros y asesoria para pequenos negocios en Cincinnati y en todo Ohio. Te atendemos en espanol e ingles.",
          },
          en: {
            title: "Bookkeeping & Business Consulting in Cincinnati, Ohio | Mi Conta Universal",
            desc: "Bookkeeping, payroll, financial reporting and consulting for small businesses in Cincinnati and across Ohio. We serve you in English and Spanish.",
          },
        };

        function apply(lang) {
          var isEn = lang === "en";
          document.documentElement.lang = isEn ? "en" : "es";

          document.querySelectorAll("[data-en]").forEach(function (el) {
            if (el.dataset.es === undefined) el.dataset.es = el.innerHTML;
            el.innerHTML = isEn ? el.dataset.en : el.dataset.es;
          });
          document.querySelectorAll("[data-en-ph]").forEach(function (el) {
            if (el.dataset.esPh === undefined) el.dataset.esPh = el.getAttribute("placeholder") || "";
            el.setAttribute("placeholder", isEn ? el.dataset.enPh : el.dataset.esPh);
          });
          document.querySelectorAll("[data-en-aria]").forEach(function (el) {
            if (el.dataset.esAria === undefined) el.dataset.esAria = el.getAttribute("aria-label") || "";
            el.setAttribute("aria-label", isEn ? el.dataset.enAria : el.dataset.esAria);
          });

          var m = META[isEn ? "en" : "es"];
          document.title = m.title;
          var d = document.querySelector('meta[name="description"]');
          if (d) d.setAttribute("content", m.desc);

          document.querySelectorAll("[data-lang]").forEach(function (b) {
            var on = b.dataset.lang === (isEn ? "en" : "es");
            b.setAttribute("aria-pressed", String(on));
            b.className = on
              ? "rounded-full px-3 py-1.5 font-[family-name:var(--font-head)] text-[0.76rem] font-extrabold tracking-wider text-white transition bg-[linear-gradient(120deg,var(--navy),var(--green))]"
              : "rounded-full px-3 py-1.5 font-[family-name:var(--font-head)] text-[0.76rem] font-extrabold tracking-wider text-[var(--muted)] transition hover:text-[var(--navy)]";
          });

          try { localStorage.setItem("mcu-lang", isEn ? "en" : "es"); } catch (e) {}
        }

        var initial = "es";
        try {
          var q = new URLSearchParams(location.search).get("lang");
          var saved = localStorage.getItem("mcu-lang");
          if (q === "en" || q === "es") initial = q;
          else if (saved === "en" || saved === "es") initial = saved;
          else if ((navigator.language || "").toLowerCase().indexOf("es") !== 0) initial = "en";
        } catch (e) {}

        document.addEventListener("click", function (ev) {
          var btn = ev.target.closest("[data-lang]");
          if (btn) apply(btn.dataset.lang);
        });

        apply(initial);
      })();

      /* ---------- Menu movil ---------- */
      (function () {
        var burger = document.getElementById("burger");
        var menu = document.getElementById("mobile-nav");
        if (!burger || !menu) return;
        burger.addEventListener("click", function () {
          var open = menu.classList.toggle("hidden");
          burger.setAttribute("aria-expanded", String(!open));
        });
        menu.addEventListener("click", function (e) {
          if (e.target.closest("a")) {
            menu.classList.add("hidden");
            burger.setAttribute("aria-expanded", "false");
          }
        });
      })();

      /* ---------- Animaciones de entrada ---------- */
      (function () {
        var rm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        var els = document.querySelectorAll(".reveal");
        if (rm || !("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach(function (el) { io.observe(el); });
      })();

      /* ---------- Acordeon: una pregunta a la vez + Micont@U reacciona ---------- */
      (function () {
        var items = document.querySelectorAll(".faq-item");
        if (!items.length) return;
        var wrap = document.querySelector(".contau-wrap");
        var t;
        items.forEach(function (item) {
          item.addEventListener("toggle", function () {
            if (!item.open) return;
            items.forEach(function (o) { if (o !== item) o.open = false; });
            if (!wrap) return;
            wrap.classList.remove("is-talking");
            void wrap.offsetWidth;
            wrap.classList.add("is-talking");
            clearTimeout(t);
            t = setTimeout(function () { wrap.classList.remove("is-talking"); }, 900);
          });
        });
      })();

      /* ---------- Formularios (Web3Forms) ---------- */
      (function () {
        var ACCESS_KEY = "PENDIENTE-ACCESS-KEY-WEB3FORMS";
        var MSG = {
          ok: {
            es: "Listo. Recibimos tus datos y te contactamos muy pronto.",
            en: "Done. We received your information and will contact you shortly.",
          },
          error: {
            es: "No pudimos enviar el formulario. Escribenos por WhatsApp al (513) 827-0407.",
            en: "We could not send the form. Please message us on WhatsApp at (513) 827-0407.",
          },
          sending: { es: "Enviando...", en: "Sending..." },
        };

        document.querySelectorAll("form[data-w3f]").forEach(function (form) {
          var status = form.querySelector(".form-status");
          var submit = form.querySelector('button[type="submit"]');
          var submitLabel = submit ? submit.innerHTML : "";

          form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var lang = document.documentElement.lang === "en" ? "en" : "es";
            var bot = form.querySelector('input[name="botcheck"]');
            if (bot && bot.checked) return;

            status.classList.remove("is-ok", "is-error");
            if (submit) { submit.disabled = true; submit.innerHTML = MSG.sending[lang]; }

            var data = Object.fromEntries(new FormData(form).entries());
            data.access_key = ACCESS_KEY;
            data.from_name = "micontau.com";
            data.idioma_del_visitante = lang;

            fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(data),
            })
              .then(function (r) { return r.json(); })
              .then(function (r) {
                if (!r.success) throw new Error("web3forms");
                status.classList.add("is-ok");
                status.textContent = MSG.ok[lang];
                form.reset();
                if (window.fbq) window.fbq("track", "Lead");
                if (window.gtag) window.gtag("event", "generate_lead", { origen: form.dataset.w3f });
              })
              .catch(function () {
                status.classList.add("is-error");
                status.textContent = MSG.error[lang];
              })
              .finally(function () {
                if (submit) { submit.disabled = false; submit.innerHTML = submitLabel; }
              });
          });
        });
      })();
    </script>

    {analyticsBootstrap && <script is:inline set:html={analyticsBootstrap}></script>}
    {GA_MEASUREMENT_ID && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    )}
  </body>
</html>
